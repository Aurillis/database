const money = n => '$' + Math.round(n).toLocaleString();
const num = n => Math.round(n).toLocaleString();
document.getElementById('brandStrategy').innerHTML = `<table><thead><tr><th>品牌</th><th>主力类型</th><th>价格带</th><th>核心打法</th><th>销售额</th></tr></thead><tbody>${data.brandStrategyRows.map(d=>`<tr><td><b>${d.brand}</b></td><td><span class="pill">${d.mainType}</span></td><td>${d.band}</td><td>${d.play}</td><td class="num">${money(d.revenue)}</td></tr>`).join('')}</tbody></table>`;
document.getElementById('scoreGrid').innerHTML = data.scoreRows.map(d=>`<div class="scorecard"><div class="n">${d.score}</div><div class="t">${d.label}</div><p>${d.note}</p></div>`).join('');
const maxFeature = Math.max(...data.featureRows.map(d=>d.count));
document.getElementById('featureBars').innerHTML = data.featureRows.map(d=>`<div><div class="barrow"><b>${d.label}</b><div class="track"><div class="fill" style="width:${d.count/maxFeature*100}%"></div></div><span>${d.count} ASIN</span></div><div class="note" style="margin-left:160px">${d.note}</div></div>`).join('');

if(data.vocPain){
  const vp=data.vocPain;
  const unmet=(vp.unmet||[]).map(d=>`<tr><td><b>${d.name}</b></td><td class="num"><b style="color:${d.priority==='高'?'#c64d48':(d.priority==='中'?'#d99a28':'#7aa6a3')}">${d.priority}</b></td><td>${d.detail}</td></tr>`).join('');
  document.getElementById('vocPainBox').innerHTML=`<p class="vocmeta">样本 ${vp.validN} 条竞品评论（${vp.date_min} ~ ${vp.date_max}），来源：${vp.source.split('/').pop()}；以下为跨星级语义实算的分析归纳，不含买家原文。</p><h5 style="margin:6px 0 8px;font-size:13px;color:var(--teal)">主题命中占比（正向绿 / 负向红 · 按占比降序）</h5><div id="vocThemeChart" class="chart" style="height:470px"></div><p class="note">主题命中占比=该主题被提及评论占样本比例（可重叠、合计&gt;100%）；悬停查看关联均星与正负向。</p><h5 style="margin:14px 0 8px;font-size:13px;color:var(--teal)">未满足点（需求缺口 · 分析归纳）</h5><table><thead><tr><th style="width:200px">未满足点</th><th style="width:70px">优先级</th><th>分析（VOC 报告「未满足需求」段）</th></tr></thead><tbody>${unmet}</tbody></table>`;
  const _sc=data.scenarioRows.filter(d=>!d.pm);
  const _top=_sc.slice(0,4);
  document.getElementById('scenarioInsightBox').innerHTML=`<p class="vocmeta">评论聚类使用情境 Top ${_top.length}（全量 ${_sc.length} 个场景见上方场景覆盖图）${vp.scenario_note?('。报告解读：'+vp.scenario_note):''}</p><div class="vocwrap3">${_top.map(d=>`<div class="vocitem"><div class="vh"><span class="vn">${d.name}</span><span class="vm">${d.hit} 条 · ${d.pct}%</span></div><div class="vm">关联均星 ${d.avg_star}★ · 星级分布 低${d.low} / 中${d.mid} / 高${d.high}</div>${(d.quotes&&d.quotes.length)?('<div class="vq">'+d.quotes.map(q=>'“★'+q.star+' '+q.text+'”').join('<br>')+'</div>'):''}</div>`).join('')}</div>`;
} else {
  document.getElementById('vocPainBox').innerHTML='<p class="note">本类目暂无对应的竞品评论 VOC 报告，好评/差评/未满足点待基于评论语义分析补充。</p>';
  document.getElementById('scenarioInsightBox').innerHTML='<p class="note">本类目暂无对应的竞品评论 VOC 报告，使用情境洞察待补充；上方场景覆盖图为 PM 分析框架（非评论数据）。</p>';
}
document.getElementById('definitionCards').innerHTML = data.definitionRows.map(d=>`<div class="paramcell"><div class="head"><div class="title">${d.title}</div><span class="flag ${d.tag=='优先'?'high':''}">${d.tag}</span></div><div class="hint">${d.body}</div></div>`).join('');
document.getElementById('checklist').innerHTML = data.checklistRows.map(d=>`<li>${d}</li>`).join('');
document.getElementById('ppcMatrix').innerHTML = `<table><thead><tr><th>核心词</th><th>类型</th><th>2026-09 搜索</th><th>趋势变化</th><th>PPC</th></tr></thead><tbody>${data.keywordTrendRows.map(d=>`<tr><td><b>${d.keyword}</b></td><td><span class="pill">${d.catLabel}</span></td><td class="num">${num(d.latest)}</td><td class="num"><b style="color:#236b6f">${d.growthText}</b></td><td class="num"><b style="color:#a86708">${d.ppcText}</b></td></tr>`).join('')}</tbody></table>`;
function renderKeywordTable() {
  let rows = data.keywordRows;
  document.getElementById('keywordTable').innerHTML = `<thead><tr><th>关键词</th><th>分层</th><th>月搜索</th><th>购买量</th><th>购买率</th><th>PPC</th><th>商品数</th><th>供需比</th><th>标题密度</th></tr></thead><tbody>${rows.map(k=>`<tr><td><b>${k.keyword}</b></td><td><span class="pill">${k.catLabel}</span></td><td class="num">${num(k.searches)}</td><td class="num">${num(k.purchases)}</td><td class="num">${(k.purchaseRate*100).toFixed(1)}%</td><td class="num"><b style="color:#a86708">${k.bidText}</b></td><td class="num">${num(k.products)}</td><td class="num">${k.supplyDemandRatio.toFixed(1)}</td><td class="num">${k.titleDensity}</td></tr>`).join('')}</tbody>`;
}
renderKeywordTable();
document.getElementById('typeTable').innerHTML = `<table><thead><tr><th>产品图片</th><th>代表产品 / 类型</th><th>ASIN数</th><th>月销量</th><th>月销售额</th><th>均价</th></tr></thead><tbody>${data.typeRows.map(d=>`<tr><td class="imgcell"><img class="prodimg" src="${d.img}" loading="lazy" onerror="this.style.display='none'"></td><td><div class="typeitem"><div><b>${d.label}</b><small>${d.brand}</small></div></div></td><td class="num">${d.count}</td><td class="num">${num(d.units)}</td><td class="num">${money(d.revenue)}</td><td class="num">${d.avgPrice.toFixed(2)}</td></tr>`).join('')}</tbody></table>`;
document.getElementById('productTable').innerHTML = `<thead><tr><th>图片</th><th>ASIN</th><th>品牌</th><th>标题</th><th>类型</th><th>价格</th><th>月销</th><th>月销售额</th><th>BSR</th><th>上架日期</th><th>卖家/配送</th><th>评分</th><th>详情</th></tr></thead><tbody>${data.products.map(p=>`<tr><td><img class="thumb" src="${p.image}" loading="lazy"></td><td><a href="${p.link}" target="_blank" rel="noopener"><b>${p.asin}</b></a></td><td>${p.brand}</td><td>${p.title}</td><td><span class="pill">${p.typeLabel}</span></td><td class="num">${p.price.toFixed(2)}</td><td class="num">${num(p.units)}</td><td class="num">${money(p.revenue)}</td><td class="num">${num(p.bsr)}</td><td>${p.availableDate}</td><td>${p.sellerName} / ${p.fulfillment}</td><td class="num">${p.rating} / ${num(p.reviews)}</td><td><a href="${p.link}" target="_blank" rel="noopener">Amazon</a></td></tr>`).join('')}</tbody>`;
const palette = ['#236b6f','#2f8d83','#d99a28','#7aa6a3','#c64d48','#9dbbb7'];
if (window.echarts) {
  echarts.init(document.getElementById('brandChart')).setOption({color:palette,tooltip:{trigger:'axis',formatter:ps=>{var p=ps[0];var d=data.brandRows[p.dataIndex];return p.name+'<br/>销售额 '+money(p.value)+'<br/>占比 '+d.share+'%';}},grid:{left:110,right:20,top:10,bottom:25},xAxis:{type:'value',axisLabel:{formatter:v=>'$'+(v/1000).toFixed(0)+'k'}},yAxis:{type:'category',inverse:true,data:data.brandRows.map(d=>d.label)},series:[{type:'bar',data:data.brandRows.map(d=>d.revenue),barWidth:14,label:{show:true,position:'right',formatter:p=>{var d=data.brandRows[p.dataIndex];return money(p.value)+' ('+d.share+'%)';}}}]});
  echarts.init(document.getElementById('typeRevenueChart')).setOption({color:palette,tooltip:{trigger:'item',formatter:p=>`${p.name}<br/>${money(p.value)} (${p.percent}%)`},legend:{bottom:0},series:[{type:'pie',radius:['46%','72%'],center:['50%','44%'],data:data.typeRows.map(d=>({name:d.label,value:d.revenue})),label:{formatter:p=>`${p.name}<br/>${p.percent}%`}}]});
  echarts.init(document.getElementById('keywordTrendChart')).setOption({color:palette,tooltip:{trigger:'axis'},legend:{top:0,data:data.keywordTrend.series.map(s=>s.name)},grid:{left:58,right:22,top:42,bottom:66},xAxis:{type:'category',data:data.keywordTrend.months,axisLabel:{rotate:45,interval:5,fontSize:10}},yAxis:{type:'value',axisLabel:{formatter:v=>(v/1000).toFixed(0)+'k'}},series:data.keywordTrend.series.map(s=>({name:s.name,type:'line',smooth:true,symbol:'none',lineWidth:2,data:s.data}))});
  echarts.init(document.getElementById('priceChart')).setOption({color:['#2f8d83','#d99a28'],tooltip:{trigger:'axis'},legend:{top:0},grid:{left:48,right:18,top:38,bottom:36},xAxis:{type:'category',data:data.priceRows.map(d=>d.label)},yAxis:[{type:'value',name:'Sales',axisLabel:{formatter:v=>v/1000+'k'}},{type:'value',name:'Units'}],series:[{name:'销售额',type:'bar',data:data.priceRows.map(d=>d.revenue)},{name:'销量',type:'line',yAxisIndex:1,smooth:true,data:data.priceRows.map(d=>d.units)}]});
  echarts.init(document.getElementById('scenarioChart')).setOption(data.scenarioRows.some(d=>d.pm)?{color:['#236b6f'],tooltip:{trigger:'axis',axisPointer:{type:'shadow'}},grid:{left:150,right:18,top:16,bottom:28},xAxis:{type:'value',axisLabel:{formatter:v=>'$'+(v/1000).toFixed(0)+'k'}},yAxis:{type:'category',inverse:true,data:data.scenarioRows.map(d=>d.label)},series:[{type:'bar',barWidth:16,data:data.scenarioRows.map(d=>d.revenue),label:{show:true,position:'right',formatter:p=>money(p.value)}}]}:{color:['#236b6f'],tooltip:{trigger:'axis',axisPointer:{type:'shadow'},formatter:p=>{const d=data.scenarioRows[p.dataIndex];return d.name+'<br/>提及 '+d.hit+' 条（'+d.pct+'%）· 均星 '+d.avg_star+'★';}},grid:{left:150,right:18,top:16,bottom:28},xAxis:{type:'value',axisLabel:{formatter:v=>v+'%'}},yAxis:{type:'category',inverse:true,data:data.scenarioRows.map(d=>d.name)},series:[{type:'bar',barWidth:16,data:data.scenarioRows.map(d=>d.pct),label:{show:true,position:'right',formatter:p=>p.value+'%'}}]});
  if(data.vocPain){
    const _th=[...data.vocPain.positives.map(d=>({name:d.name,pct:d.pct,star:d.star,kind:1})),...data.vocPain.negatives.map(d=>({name:d.name,pct:d.pct,star:d.star,kind:0,risk:d.risk}))].sort((a,b)=>b.pct-a.pct);
    echarts.init(document.getElementById('vocThemeChart')).setOption({grid:{left:200,right:46,top:10,bottom:28},tooltip:{trigger:'axis',axisPointer:{type:'shadow'},formatter:p=>{const d=_th[p.dataIndex];return d.name+'<br/>命中占比 '+d.pct+'% · 关联均星 '+d.star+'★'+(d.kind?' · 正向主题':' · 负向主题 '+d.risk);}},xAxis:{type:'value',axisLabel:{formatter:v=>v+'%'}},yAxis:{type:'category',inverse:true,axisLabel:{fontSize:11},data:_th.map(d=>({value:d.name,textStyle:{color:d.kind?'#2f8d83':'#c64d48'}}))},series:[{type:'bar',barWidth:12,data:_th.map(d=>({value:d.pct,itemStyle:{color:d.kind?'#2f8d83':'#c64d48',borderRadius:[0,3,3,0]}})),label:{show:true,position:'right',fontSize:11,formatter:p=>p.value+'%'}}]});
  }
  echarts.init(document.getElementById('scatterChart')).setOption({color:['#236b6f'],tooltip:{formatter:p=>`${p.data[3]}<br/>Price: ${p.data[0]}<br/>Revenue: ${money(p.data[1])}<br/>Units: ${num(p.data[2])}<br/>${p.data[4]}`},grid:{left:58,right:18,top:16,bottom:42},xAxis:{type:'value',name:'Price',axisLabel:{formatter:v=>'$'+v}},yAxis:{type:'value',name:'Revenue',axisLabel:{formatter:v=>'$'+(v/1000).toFixed(0)+'k'}},series:[{type:'scatter',symbolSize:p=>Math.max(8,Math.min(30,Math.sqrt(p[2])*1.05)),data:data.products.map(p=>[p.price,p.revenue,p.units,p.asin+' '+p.brand,p.typeLabel])}]});
  window.addEventListener('resize',()=>{for(const el of document.querySelectorAll('.chart')){const inst=echarts.getInstanceByDom(el); if(inst) inst.resize();}});
}
</script>
</body>
</html>