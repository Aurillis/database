<!-- ===== 9. BUSINESS MODEL ===== -->
<section class="section" id="business-model">
  <div class="section-head">
    <span class="section-num">09</span>
    <h2 class="section-title">商业模式对比</h2>
  </div>

  <div class="bm-grid">
