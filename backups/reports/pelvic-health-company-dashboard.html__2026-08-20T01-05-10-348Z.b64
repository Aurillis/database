        <!-- 7. 业务结构 -->
        <div class="sub-section">
          <div class="sub-title">7. 2025年业务结构</div>
          <div class="prop-bars">
            <div class="prop-row"><div class="prop-label">盆底康复产品</div><div class="prop-track"><div class="prop-fill" style="width:37%"></div></div><div class="prop-val">~1.60亿</div></div>
            <div class="prop-row"><div class="prop-label">生殖康复产品</div><div class="prop-track"><div class="prop-fill" style="width:29.4%;opacity:.75"></div></div><div class="prop-val">~1.27亿</div></div>
            <div class="prop-row"><div class="prop-label">耗材及配件</div><div class="prop-track"><div class="prop-fill" style="width:28.2%;opacity:.55"></div></div><div class="prop-val">~1.22亿</div></div>
            <div class="prop-row"><div class="prop-label">运动康复及其他</div><div class="prop-track"><div class="prop-fill" style="width:5.3%;opacity:.35"></div></div><div class="prop-val">占比较小</div></div>
